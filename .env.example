NANOWIKI_DATA_DIR=/path/to/your/wiki/data
PORT=3001

# LLM provider, configure exactly one block. Leave the others commented out.

# Option 1: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Anthropic / Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Option 3: Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
