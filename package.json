{
  "name": "nanowiki",
  "version": "4.01.0",
  "description": "A minimalist local wiki: no login, no cloud, just Markdown files. Fulltext search included.",
  "author": "Christian Kellner",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "wiki",
    "markdown",
    "self-hosted",
    "local-first",
    "notes",
    "knowledge-base",
    "personal-wiki",
    "fulltext-search",
    "editor"
  ],
  "bugs": {
    "url": "https://github.com/orangecoding/nanowiki/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "dev": "vite frontend",
    "build": "vite build frontend",
    "start": "yarn build && node --env-file=.env backend/src/server.js",
    "test": "yarn test:backend && yarn test:frontend",
    "test:backend": "vitest run --config backend/vitest.config.js",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "copyright": "node ./tools/copyright.js",
    "release": "node ./tools/release/release.js"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "yarn copyright"
    ],
    "**/*.{json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@fastify/cors": "^11",
    "@fastify/multipart": "^10",
    "@fastify/static": "^9",
    "@fastify/websocket": "^11",
    "@tiptap/extension-code-block-lowlight": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-strike": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "better-sqlite3": "^12",
    "chokidar": "^5",
    "codemirror": "^6",
    "dotenv": "^17",
    "fastify": "^5",
    "lowlight": "^3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19",
    "react-dom": "^19",
    "tiptap-markdown": "^0.9"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@vitejs/plugin-react": "^6",
    "autoprefixer": "^10",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "latest",
    "husky": "latest",
    "jsdom": "^29",
    "lint-staged": "latest",
    "postcss": "^8",
    "prettier": "latest",
    "tailwindcss": "^3",
    "vite": "^8",
    "vitest": "^4"
  }
}
