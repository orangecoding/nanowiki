{
  "name": "nanowiki",
  "version": "4.0.1",
  "description": "A minimalist local wiki: no login, no cloud, just Markdown files. Fulltext search included.",
  "author": "Christian Kellner",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "wiki",
    "markdown",
    "self-hosted",
    "local-first",
    "notes",
    "knowledge-base",
    "personal-wiki",
    "fulltext-search",
    "editor"
  ],
  "bugs": {
    "url": "https://github.com/orangecoding/nanowiki/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "dev": "vite frontend",
    "build": "vite build frontend",
    "start": "yarn build && node --env-file=.env backend/src/server.js",
    "test": "yarn test:backend && yarn test:frontend",
    "test:backend": "vitest run --config backend/vitest.config.js",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "copyright": "node ./tools/copyright.js",
    "release": "node ./tools/release/release.js"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "yarn copyright"
    ],
    "**/*.{json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@tiptap/extension-code-block-lowlight": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-strike": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "lowlight": "^3.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.15",
    "vitest": "^4.1.8"
  }
}
